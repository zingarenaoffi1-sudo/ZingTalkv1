{
	"appId": "com.zingtalk.com",
	"appName": "ZingTalk",
	"webDir": "dist",
	"bundledWebRuntime": false,
	"server": {
		"androidScheme": "http",
		"cleartext": true,
		"allowNavigation": [
			"zingtalk.duckdns.org",
			"zingtalk.duckdns.org:*",
			"*.duckdns.org",
			"*.google.com",
			"*.firebaseapp.com",
			"*.googleapis.com"
		]
	}
}
