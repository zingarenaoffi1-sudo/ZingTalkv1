rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 10-Digit UID Mappings collection
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Profiles indexed by Firebase Auth UID
    match /user_profiles/{authUid} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default authenticated access
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
